        }
        
    }
}
//*******LCD Initialization*******
void lcd_init()
{
    lcd_cmd(0x38);  // Set LCD to 8-bit mode, 2 lines, 5x7 matrix
    lcd_cmd(0x80); // cursor in the first row
    lcd_cmd(0x0E);  // Display ON, Cursor Blinking
    __delay_ms(10); //small delay for viewing cursor
    lcd_cmd(0x0C);  // Display ON, Cursor OFF
  //  lcd_cmd(0x06);  // Auto Increment cursor
    lcd_cmd(0x01);  // Clear display
    __delay_ms(2);
}
//******LCD Command******
void lcd_cmd(unsigned char cmd)
{
    PORTD = cmd;
    rs = 0; //selecting command register
    rw = 0;
    en = 1;
    __delay_ms(5);
    en = 0;
}
//******LCD data******
void lcd_char(char data)
{
    PORTD = data;
    rs = 1;  //selecting data register
    rw = 0;
    en = 1;
    __delay_ms(5);
    en = 0;
}
//*******LCD String******
void lcd_str(const unsigned char *p, unsigned char length)
{
    unsigned char i ;
    for(i=0;i<length;i++)
    {
        lcd_char(p[i]);
    }
}
//*******Function to find No Of Digits*******
int no_of_digit(int num)
{
    int T_digit = 0;
    while(num != 0)
    {
        T_digit++;
        num = num/10;
    }
    return T_digit;
}
//*******function definition for time1-initialization*******
void timer1_init(void)
{
    T1CON = 0x00;//prescale vaue as 1, 
    PIE1bits.TMR1IE = 1; //timer1 interrupt enable
    TMR1L = 0x00;
    TMR1H = 0x00;
}
void dispay_rpm(unsigned int rpm)
{
    int total_digit;
    total_digit = no_of_digit(rpm);
    if(total_digit == 1)
    {
        lcd_cmd(0x88);
        lcd_char(rpm + 48);
    }
    if(total_digit == 2)
    {
        lcd_cmd(0x88);
        lcd_char((rpm/10) + 48);//for printing first digit
        lcd_cmd(0x89);
        lcd_char((rpm%10) + 48);//for printing last digit
    }
    if(total_digit == 3)
    {
        lcd_cmd(0x88);
        lcd_char((rpm/100) + 48);//for first digit
        lcd_cmd(0x89);
        lcd_char(((rpm/ 10) %10) + 48);//for printing second digit
        lcd_cmd(0x8A);
        lcd_char((rpm % 10) + 48);//for three digit number
    }
    if(total_digit == 4 )
    {            
        lcd_cmd(0x88);
        lcd_char((rpm / 1000) + 48);//for printing first digit
        lcd_cmd(0x89);
        lcd_char(((rpm/100)%10) + 48);//for printing second digit
        lcd_cmd(0x8A);
        lcd_char(((rpm/10)%10) + 48);//for printing third digit
        lcd_cmd(0x8B);
        lcd_char((rpm%10) + 48);//for printing fourth digit
    }
        
}
