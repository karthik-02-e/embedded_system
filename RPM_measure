//*******globel variable declaration*******
unsigned int count; //for count speed sensor detection
void __interrupt() ISR()
{
    if(INTCONbits.INTF == 1)
    {
        count++;
        T1CONbits.TMR1ON = 1;//making timer ON when first interrupt occurence
        INTCONbits.INTF = 0;
    }
    if(PIR1bits.TMR1IF == 1)
    {
        time_count++;
        if(time_count == 2307)
        {
            T1CONbits.TMR1ON = 0;
            tot_rpm = count;flag = 1;
        }
        TMR1L = 0x00;
        TMR1H = 0x00;
        PIR1bits.TMR1IF = 0;
    }
} 
void main(void) {
    TRISE = 0X00;//register select , enable
