    TRISBbits.TRISB0 = 1; //making RB0 as input : going to use as external interrupt
    INTCONbits.GIE = 1; //Enables all unmasked interrupts
    INTCONbits.PEIE = 1; //Enables all unmasked peripheral interrupts
